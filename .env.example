# KHOTAA App - Environment Variables
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to Git!

# API secret for the Vercel email server (same value as API_SECRET in Vercel env vars)
API_SECRET=your-api-secret-here

# Vercel server base URL
API_BASE_URL=https://khotaa-email-server.vercel.app

# Agora App ID (get this from your Agora dashboard — safe to put here, not secret)
AGORA_APP_ID=your-agora-app-id-here

# Agora temporary token (from Agora console → your project → "Temp Token" button)
# Valid for 24h — testing only. Must match the channel name below.
AGORA_TOKEN=your-temporary-token-here

# The channel name you used when generating the temp token (e.g. khotaa_test)
AGORA_TEST_CHANNEL=khotaa_test
