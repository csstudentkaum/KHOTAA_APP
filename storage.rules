rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Patient foot images — only the owning patient can read/write
    match /medical_images/{userId}/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
